# This laptop's LAN/Wi-Fi IP (macOS: ipconfig getifaddr en0)
LAN_IP=192.168.1.23
MCP_PORT=8765

# Your user, so the token and DB files are owned by you (run: id -u ; id -g)
HOST_UID=501
HOST_GID=20

# Local directory where .mcp_token is written
TOKEN_DIR=./secrets

# Docker network for the container; ALLOW_CIDR must contain its gateway
DOCKER_SUBNET=172.28.0.0/24
ALLOW_CIDR=172.28.0.0/24

